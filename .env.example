# MongoDB connection string
# MongoDB Atlas (free tier):
# DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>?retryWrites=true&w=majority"
#
# MongoDB local (Docker com replica set):
# DATABASE_URL="mongodb://localhost:27017/<db-name>?replicaSet=rs0"

DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/empresa-dev?retryWrites=true&w=majority"

# ─── Cloudflare R2 (upload de anexos) ───────────────────────────────
# Crie um bucket PRIVADO e um API Token (Object Read & Write) no painel do R2.
# R2_ENDPOINT = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#
# CORS do bucket (obrigatório, o browser faz PUT direto no R2):
#   AllowedOrigins: http://localhost:3000 e o domínio de produção
#   AllowedMethods: PUT, GET
#   AllowedHeaders: Content-Type
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="seu-access-key"
R2_SECRET_ACCESS_KEY="seu-secret-key"
R2_BUCKET_NAME="empresa-uploads"
